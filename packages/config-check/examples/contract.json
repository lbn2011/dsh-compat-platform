{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["retries"],
  "additionalProperties": false,
  "properties": {
    "retries": { "type": "integer", "minimum": 0, "maximum": 5 },
    "mode": { "type": "string", "enum": ["safe", "fast"] },
    "endpoint": { "type": "string", "format": "uri" }
  }
}
