{
  "name": "@dsh-compat/config-check",
  "version": "0.1.0-draft.1",
  "type": "module",
  "description": "Configuration contract checking for the DSH compatibility protocol: a JSON Schema 2020-12 instance check over an acquired, unpatched engine, with explicit not-checked outcomes.",
  "engines": {
    "node": ">=24.9.0"
  },
  "dependencies": {
    "@hyperjump/browser": "1.6.0",
    "@hyperjump/json-schema": "1.18.0"
  },
  "main": "./src/config-check.js",
  "files": [
    "src/",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./src/config-check.d.ts",
      "default": "./src/config-check.js"
    },
    "./engine": {
      "types": "./src/hyperjump-engine.d.ts",
      "default": "./src/hyperjump-engine.js"
    },
    "./cli": "./src/config-check-cli.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-compat-config-check": "./src/config-check-cli.js"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 \"tests/*.test.js\""
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lbn2011/dsh-compat-platform.git"
  }
}
