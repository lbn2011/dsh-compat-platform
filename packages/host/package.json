{
  "name": "dsh-compat-diagnostics-ui",
  "version": "0.1.0-draft.1",
  "type": "module",
  "description": "Read-only host route that displays one dsh-compat-diagnose envelope. Serves a static page and the envelope JSON verbatim; performs no analysis and writes nothing.",
  "engines": {
    "node": ">=24.9.0"
  },
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./page": "./src/page.js",
    "./envelope": "./src/envelope.js",
    "./client": "./src/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src/",
    "README.md"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 \"tests/*.test.js\""
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lbn2011/dsh-compat-platform.git"
  }
}
